---
<section class="pt-4 md:pt-6 pb-12 md:pb-16 px-4 bg-[#F9F5EE]">
  <div class="max-w-5xl mx-auto">
    
    <div class="bg-white rounded-3xl border border-gray-200/80 p-8 md:p-12 shadow-sm">
      
      <div class="text-center mb-10">
        <span class="text-[#B21D42] font-bold uppercase text-xs tracking-widest bg-red-50 px-3.5 py-1.5 rounded-full border border-red-100">
          Eckdaten & Investition
        </span>
        <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mt-4">
          Rahmendaten der PROSYNUS KI-Masterclass
        </h2>
        <p class="text-gray-600 mt-2 text-sm md:text-base">
          Transparente Zeit- und Kostenplanung für dein Business.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <div class="bg-[#F9F5EE]/60 rounded-2xl p-6 border border-gray-200/80 text-center flex flex-col justify-between">
          <div>
            <span class="text-xs font-bold text-gray-500 uppercase tracking-wider block mb-2">
              Gesamtdauer
            </span>
            <span class="text-3xl font-extrabold text-gray-900 block">
              36 Stunden
            </span>
          </div>
          <p class="text-xs text-gray-600 mt-3 leading-relaxed">
            Praxisbegleitend & flexibel in deinen Arbeitsalltag integrierbar.
          </p>
        </div>

        <div class="bg-[#F9F5EE]/60 rounded-2xl p-6 border border-gray-200/80 text-center flex flex-col justify-between">
          <div>
            <span class="text-xs font-bold text-gray-500 uppercase tracking-wider block mb-2">
              Regulärer Kurswert
            </span>
            <span class="text-3xl font-extrabold text-gray-900 block">
              3.850 €
            </span>
          </div>
          <p class="text-xs text-gray-600 mt-3 leading-relaxed">
            Gesamter Schulungs- und Praxisumfang.
          </p>
        </div>

        <div class="bg-[#2E3641] text-white rounded-2xl p-6 text-center flex flex-col justify-between shadow-md">
          <div>
            <span class="text-xs font-bold text-red-400 uppercase tracking-wider block mb-2">
              Möglicher Eigenanteil
            </span>
            <span class="text-3xl font-extrabold text-white block">
              385 €
            </span>
          </div>
          <p class="text-xs text-gray-300 mt-3 leading-relaxed">
            Bei positiver Förderentscheidung durch die Anlaufstelle (bis zu 90% Zuschuss).
          </p>
        </div>

      </div>

    </div>

  </div>
</section>