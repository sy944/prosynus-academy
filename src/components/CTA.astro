---
---
<section id="beratung" class="py-12 md:py-20 px-4 bg-[#F9F5EE]">
  <div class="max-w-6xl mx-auto">
    
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-stretch">
      
      <!-- KACHEL 1: ERSTBERATUNG ANFORDERN (FORMULAR) -->
      <div class="bg-white rounded-3xl border border-gray-200/80 p-8 md:p-10 shadow-sm flex flex-col justify-between">
        <div>
          <span class="inline-block text-[#B21D42] font-bold uppercase text-xs tracking-widest bg-red-50 px-3.5 py-1.5 rounded-full border border-red-100 mb-4">
            Per Formular
          </span>
          <h2 class="text-2xl font-extrabold text-gray-900 mb-3">
            Kostenfreie Erstberatung anfordern
          </h2>
          <p class="text-gray-600 text-sm leading-relaxed mb-6">
            Trag deine Daten ein. Wir melden uns innerhalb von 24 Stunden persönlich bei dir, um deine Fragen zur PROSYNUS KI-Masterclass und zur Förderfähigkeit zu klären.
          </p>

          <form id="lead-form" class="space-y-4">
            <div>
              <label for="lead-name" class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Dein Name *</label>
              <input 
                type="text" 
                id="lead-name" 
                name="name" 
                required 
                placeholder="z. B. Maria Muster"
                class="w-full px-4 py-3 rounded-xl border border-gray-300 text-sm focus:outline-none focus:ring-2 focus:ring-[#2E3641] transition-all"
              />
            </div>

            <div>
              <label for="lead-email" class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">E-Mail-Adresse *</label>
              <input 
                type="email" 
                id="lead-email" 
                name="email" 
                required 
                placeholder="maria@muster-business.de"
                class="w-full px-4 py-3 rounded-xl border border-gray-300 text-sm focus:outline-none focus:ring-2 focus:ring-[#2E3641] transition-all"
              />
            </div>

            <div>
              <label for="lead-phone" class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Telefonnummer (optional)</label>
              <input 
                type="tel" 
                id="lead-phone" 
                name="phone" 
                placeholder="Für die schnelle Terminabsprache"
                class="w-full px-4 py-3 rounded-xl border border-gray-300 text-sm focus:outline-none focus:ring-2 focus:ring-[#2E3641] transition-all"
              />
            </div>

            <label class="flex items-start gap-3 mt-4 cursor-pointer">
              <input type="checkbox" id="privacy-check" required class="mt-1 rounded border-gray-300 text-[#B21D42] focus:ring-[#B21D42]" />
              <span class="text-xs text-gray-500 leading-normal">
                Ich stimme zu, dass PROSYNUS meine Daten zur Kontaktaufnahme verarbeitet. Hinweise zum Datenschutz findest du im Impressum.
              </span>
            </label>

            <button type="submit" id="submit-btn" class="w-full bg-[#B21D42] hover:bg-[#901734] text-white font-bold py-3.5 rounded-xl shadow-sm transition-all mt-4 cursor-pointer">
              Erstberatung jetzt anfordern
            </button>
          </form>

          <!-- Erfolgsmeldung -->
          <div id="form-success" class="hidden mt-6 p-4 rounded-xl bg-green-50 border border-green-200 text-green-800 text-sm">
            🎉 <strong>Vielen Dank!</strong> Deine Anfrage ist eingegangen. Wir melden uns in Kürze persönlich bei dir.
          </div>
        </div>
      </div>

      <!-- KACHEL 2: DIREKTE TERMINBUCHUNG (GOOGLE CALENDAR) -->
      <div class="bg-[#2E3641] text-white rounded-3xl p-8 md:p-10 shadow-lg flex flex-col justify-between border border-white/10">
        <div>
          <span class="inline-block text-white font-bold uppercase text-xs tracking-widest bg-white/10 px-3.5 py-1.5 rounded-full border border-white/20 mb-4">
            Direkt-Termin
          </span>
          <h2 class="text-2xl font-extrabold text-white mb-3">
            Sofort Wunschtermin im Kalender sichern
          </h2>
          <p class="text-gray-300 text-sm leading-relaxed mb-6">
            Du möchtest keine Zeit verlieren? Wähle direkt einen freien 15-Minuten-Slot in unserem Online-Kalender für ein unverbindliches Erstgespräch.
          </p>

          <div class="space-y-3 mb-8 text-xs md:text-sm text-gray-300">
            <div class="flex items-center gap-2">
              <span class="text-green-400 font-bold">✓</span>
              <span>100 % kostenfrei & unverbindlich</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-green-400 font-bold">✓</span>
              <span>Direkte Infos zur Masterclass</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-green-400 font-bold">✓</span>
              <span>Praktischer Termin via Online-Call</span>
            </div>
          </div>
        </div>

        <a 
          href="https://calendar.app.google/7kZLR4YFW4AiBSm26" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="w-full bg-white hover:bg-gray-100 text-[#2E3641] font-bold py-4 rounded-xl text-center shadow-md transition-all inline-block"
        >
          Jetzt Erstgespräch buchen →
        </a>
      </div>

    </div>

  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('lead-form');
    const successMessage = document.getElementById('form-success');
    const submitBtn = document.getElementById('submit-btn');

    if (form && !form.dataset.listenerAttached) {
      form.dataset.listenerAttached = 'true';

      form.addEventListener('submit', function(e) {
        e.preventDefault();

        if (form.dataset.submitting === 'true') return;
        form.dataset.submitting = 'true';

        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.innerText = 'Wird gesendet...';
        }

        const nameInput = document.getElementById('lead-name');
        const emailInput = document.getElementById('lead-email');
        const phoneInput = document.getElementById('lead-phone');

        // Dein eigener n8n-Webhook
        const targetEndpoint = 'https://n8n.prosynus.de/webhook/masterclass-anfrage';

        fetch(targetEndpoint, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({
            name: nameInput ? nameInput.value : '',
            email: emailInput ? emailInput.value : '',
            phone: phoneInput ? phoneInput.value : ''
          })
        })
        .then(function(response) {
          if (response.ok) {
            form.reset();
            form.style.display = 'none';
            if (successMessage) {
              successMessage.classList.remove('hidden');
              successMessage.style.display = 'block';
            }
          } else {
            alert('Ein Übertragungsfehler ist aufgetreten.');
            resetBtn();
          }
        })
        .catch(function() {
          alert('Ein Übertragungsfehler ist aufgetreten.');
          resetBtn();
        });

        function resetBtn() {
          form.dataset.submitting = 'false';
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerText = 'Erstberatung jetzt anfordern';
          }
        }
      });
    }
  });
</script>