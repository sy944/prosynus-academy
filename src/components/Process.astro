---
const steps = [
  {
    step: "01",
    title: "Erstgespräch führen",
    description: "In einem 15-minütigen Gespräch informieren wir dich unverbindlich über die Inhalte und den Ablauf der KI-Masterclass."
  },
  {
    step: "02",
    title: "Scheck bei Anlaufstelle erhalten",
    description: "Du beantragst deinen Qualifizierungsscheck bei einer offiziellen KOMPASS-Beratungsstelle."
  },
  {
    step: "03",
    title: "KI-Masterclass absolvieren",
    description: "Du lernst Schritt für Schritt in 36 Praxis-Stunden, wie du KI gewinnbringend in deinen Alltag integrierst."
  },
  {
    step: "04",
    title: "Zertifikat und Erstattung erhalten",
    description: "Nach Kursabschluss reichst du dein Zertifikat ein und erhältst bei Förder-Bewilligung 90% der Kosten erstattet."
  }
];
---

<section id="ablauf" class="py-12 md:py-20 px-4 bg-[#2E3641] text-white">
  <div class="max-w-6xl mx-auto">
    
    <div class="text-center mb-12">
      <span class="text-white font-bold uppercase text-xs tracking-widest bg-white/10 px-3.5 py-1.5 rounded-full border border-white/20">
        Einfacher Ablauf
      </span>
      <h2 class="text-2xl md:text-4xl font-extrabold text-white mt-4">
        Dein Weg zur PROSYNUS KI-Masterclass
      </h2>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      
      <div class="lg:col-span-5 relative">
        <div class="rounded-3xl overflow-hidden shadow-2xl border border-white/10 aspect-[4/5]">
          <img 
            src="/images/process.jpg" 
            alt="Beratungsgespräch & Coaching" 
            class="w-full h-full object-cover"
          />
        </div>
        <div class="absolute -bottom-5 -right-5 bg-[#B21D42] text-white p-4 rounded-2xl shadow-xl hidden sm:block max-w-[200px] border border-red-400">
          <p class="text-xs font-bold leading-tight">Persönlich & Praxisnah </p>
        </div>
      </div>

      <div class="lg:col-span-7">
        <div class="relative pl-6 space-y-6 before:absolute before:top-2 before:bottom-2 before:left-3 before:w-0.5 before:bg-white/20">
          {steps.map((item) => (
            <div class="relative flex items-start gap-4">
              <div class="absolute -left-6 top-1 w-7 h-7 rounded-full bg-[#B21D42] text-white font-bold flex items-center justify-center text-xs z-10 border-2 border-[#2E3641]">
                {item.step}
              </div>

              <div class="bg-white text-gray-900 p-5 rounded-2xl shadow-md border border-gray-200/80 w-full ml-2">
                <h3 class="text-base font-bold text-gray-900 mb-1">
                  {item.title}
                </h3>
                <p class="text-gray-600 text-xs md:text-sm leading-relaxed">
                  {item.description}
                </p>

                {item.step === "01" && (
                  <div class="mt-4 pt-3 border-t border-gray-100 bg-emerald-50/80 rounded-xl p-3.5 border border-emerald-200/80">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                      <div>
                        <span class="inline-block text-[10px] font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded mb-1">
                          Option 1a • Selbstzahler
                        </span>
                        <h4 class="text-xs md:text-sm font-bold text-gray-900">
                          Du benötigst keine Förderung?
                        </h4>
                        <p class="text-xs text-gray-600 mt-0.5">
                          Mit oder ohne Erstgespräch direkt anmelden (Selbstzahler).
                        </p>
                      </div>
                      <a 
  href="mailto:symanski@prosynus.com?subject=Direktanmeldung%20KI-Masterclass&body=Hallo%20Herr%20Symanski,%0A%0Aich%20möchte%20mich%20direkt%20für%20die%20KI-Masterclass%20als%20Selbstzahler%20anmelden.%0A%0ABevorzugtes%20Startdatum:%20%0AName:%20%0ATelefonnummer:%20"
  class="inline-flex items-center justify-center px-3.5 py-2 bg-[#B21D42] hover:bg-[#961837] text-white text-xs font-semibold rounded-xl transition-colors whitespace-nowrap shadow-sm self-start sm:self-center"
>
  ✉️ Direkt per E-Mail anmelden
</a>
                    </div>
                  </div>
         )}
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>

    <!-- NEU: Sternchen-Hinweis zentriert unter allen Schritten -->
    <div class="mt-16 text-center text-xs text-white/70 font-medium tracking-wide">
      * Rechtlicher Hinweis zur Förderung siehe Footer.
    </div>
  </div>
</section>