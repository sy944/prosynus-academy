---
const { title = "KI-Kompass | ESF-Förderung für Solo-Selbstständige" } = Astro.props;
---

<!DOCTYPE html>
<html lang="de" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="bg-cream text-gray-900 antialiased selection:bg-red-600 selection:text-white min-h-screen">
   <link rel="icon" type="image/png" href="/favicon.ico" /> 
    <slot />
  </body>
</html>