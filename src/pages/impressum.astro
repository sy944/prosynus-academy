---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Impressum | PROSYNUS Academy">
  <main class="bg-[#F9F5EE] min-h-screen py-20 px-4 md:px-8 font-sans text-black">
    <div class="max-w-3xl mx-auto bg-white p-8 md:p-12 rounded-2xl shadow-sm border border-gray-200/50">
      
      <a href="/" class="text-sm font-semibold text-gray-500 hover:text-black transition duration-200 inline-flex items-center gap-2 mb-8">
        ← Zurück zur Startseite
      </a>

      <h1 class="text-3xl font-extrabold tracking-tight mb-8">Impressum</h1>

      <div class="space-y-6 text-gray-700 leading-relaxed">
        <div>
          <h2 class="text-lg font-bold text-black mb-2">Angaben gemäß § 5 TMG</h2>
          <p class="font-semibold text-black">PROSYNUS KI-Strategie und Organisation</p>
          <p>Holger Symanski</p>
          <p>Kralkamp 70</p>
          <p>48308 Senden / Westfalen</p>
        </div>

        <div>
          <h2 class="text-lg font-bold text-black mb-2">Kontakt</h2>
          <p>Telefon Mobil: 0173 8258756</p>
          <p>Telefon Festnetz: 02597 279505</p>
          <p>E-Mail: symanski@prosynus.com</p>
        </div>

        <div>
          <h2 class="text-lg font-bold text-black mb-2">Umsatzsteuer-ID</h2>
          <p class="italic text-gray-400">Umsatzsteuer-Identifikationsnummer gemäß § 27 a Umsatzsteuergesetz: DE252512493</p>
        </div>

        <div>
          <h2 class="text-lg font-bold text-black mb-2">Unternehmensberatung</h2>
          <p class="italic text-gray-400">Wir sind zur Teilnahme an einem Streitbeilegungsverfahren vor einer Verbraucherschlichtungsstelle weder verpflichtet noch bereit.</p>
        </div>

        <!-- BILDNACHWEISE INKL. UNSPLASH -->
        <div class="border-t border-gray-200 pt-6 mt-8">
          <h2 class="text-lg font-bold text-black mb-2">Bildnachweise</h2>
          <p>Die auf dieser Webseite verwendeten Grafiken und Bilder stammen aus folgenden Quellen:</p>
          <ul class="list-disc pl-5 mt-2 space-y-1">
            <li>Eigene Fotografien / PROSYNUS</li>
            <li>Fotografien von <span class="font-semibold">surface</span> und <span class="font-semibold">LinkedIn Sales Solutions</span> via <span class="font-semibold">Unsplash.com</span></li>
          </ul>
        </div>
      </div>

    </div>
  </main>
</Layout>